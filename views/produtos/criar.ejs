<%- include('../includes/header.ejs', { titulo: 'Novo Produto' }) %>

<main class="p-4 md:p-6 bg-neutra-50 min-h-screen flex flex-col items-center justify-center">
  <div class="bg-white rounded-xl shadow-lg p-6 w-full max-w-2xl border border-gray-200">
    <h2 class="text-2xl font-semibold text-sistema-700 mb-6 text-center">Cadastrar Novo Produto</h2>

    <% if (typeof mensagem !=='undefined' && mensagem) { %>
      <p class="text-red-600 mb-4"><%= mensagem %></p>
    <% } %>

    <form action="/produtos/novo" method="POST" class="flex flex-col gap-4">
      <!-- Nome do Produto -->
      <div>
        <label for="nome_produto" class="block text-sm font-medium text-gray-700 mb-1">Nome do Produto</label>
        <input type="text" id="nome_produto" name="nome_produto" required
               class="w-full border border-gray-300 rounded-md px-3 py-2 focus:ring-2 focus:ring-sistema-500 focus:border-sistema-500 outline-none" />
      </div>

      <!-- Descrição -->
      <div>
        <label for="descricao" class="block text-sm font-medium text-gray-700 mb-1">Descrição</label>
        <textarea id="descricao" name="descricao" rows="3"
                  class="w-full border border-gray-300 rounded-md px-3 py-2 focus:ring-2 focus:ring-sistema-500 focus:border-sistema-500 outline-none"></textarea>
      </div>

      <!-- Quantidade (somente leitura) -->
      <div>
        <label for="quantidade" class="block text-sm font-medium text-gray-700 mb-1">Quantidade em Estoque</label>
        <input type="number" id="quantidade" name="quantidade" value="0" readonly
               class="w-full border border-gray-300 bg-gray-100 text-gray-600 rounded-md px-3 py-2 cursor-not-allowed" />
      </div>

      <!-- Estoque mínimo -->
      <div>
        <label for="estoque_minimo" class="block text-sm font-medium text-gray-700 mb-1">Estoque Mínimo</label>
        <input type="number" id="estoque_minimo" name="estoque_minimo" min="0" required
               class="w-full border border-gray-300 rounded-md px-3 py-2 focus:ring-2 focus:ring-sistema-500 focus:border-sistema-500 outline-none" />
      </div>

      <!-- Valor -->
      <div>
        <label for="valor" class="block text-sm font-medium text-gray-700 mb-1">Valor (R$)</label>
        <input type="number" id="valor" name="valor" step="0.01" min="0" required
               class="w-full border border-gray-300 rounded-md px-3 py-2 focus:ring-2 focus:ring-sistema-500 focus:border-sistema-500 outline-none" />
      </div>

      <!-- Categoria -->
      <div>
        <label for="id_categoria" class="block text-sm font-medium text-gray-700 mb-1">Categoria</label>
        <select id="id_categoria" name="id_categoria" required
                class="w-full border border-gray-300 rounded-md px-3 py-2 focus:ring-2 focus:ring-sistema-500 focus:border-sistema-500 outline-none">
          <% for (let c of categoriasCadastradas) { %>
            <option value="<%= c.id_categoria %>"><%= c.nome_categoria %></option>
          <% } %>
        </select>
      </div>

      <!-- Imagem (URL) -->
      <div>
        <label for="imagem" class="block text-sm font-medium text-gray-700 mb-1">Imagem (URL)</label>
        <input type="text" id="imagem" name="imagem" placeholder="/img/produtos/exemplo.png ou https://..."
               class="w-full border border-gray-300 rounded-md px-3 py-2 focus:ring-2 focus:ring-sistema-500 focus:border-sistema-500 outline-none" />
      </div>

      <!-- Status -->
      <div class="flex items-center gap-2 mt-2">
        <input type="checkbox" id="ativo" name="ativo" value="true" checked
               class="h-4 w-4 text-sistema-600 border-gray-300 rounded focus:ring-sistema-500">
        <label for="ativo" class="text-sm text-gray-700">Produto ativo</label>
      </div>

      <!-- Botões -->
      <div class="flex justify-end gap-3 mt-6">
        <a href="/produtos" class="px-4 py-2 rounded-md bg-gray-400 text-white hover:bg-gray-500 transition">Cancelar</a>
        <button type="submit" class="px-4 py-2 rounded-md bg-sistema-600 text-white hover:bg-sistema-700 transition">
          Salvar
        </button>
      </div>
    </form>
  </div>
</main>

<%- include('../includes/footer.ejs') %>
