<%- include('../includes/header.ejs', { titulo: 'Lista de Usuários' }) %>

<main class="p-4 md:p-6 pb-24 bg-neutra-50 min-h-screen">

  <% if (typeof mensagem !=='undefined' && mensagem) { %>
    <p class="text-erro-600 mb-4 text-center"><%= mensagem %></p>
  <% } %>

  <!-- Busca + Ordenação -->
  <form action="/usuarios" method="GET" class="flex flex-col md:flex-row gap-3 items-stretch md:items-end mb-4">
    <!-- Buscar -->
    <div class="flex-1">
      <label class="block text-sm font-medium text-gray-700 mb-1">Buscar</label>
      <input type="text" name="busca" value="<%= busca || '' %>" placeholder="Nome ou login"
        class="w-full rounded-lg border border-gray-300 px-3 py-2 outline-none focus:(ring-2 ring-sistema-500 border-sistema-500)" />
    </div>

    <!-- Ordenar -->
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Ordenar por</label>
      <select name="ordenar" onchange="this.form.submit()"
        class="rounded-lg border border-gray-300 px-3 py-2 outline-none focus:(ring-2 ring-sistema-500 border-sistema-500)">
        <option value="nome" <%=ordenar==='nome' ? 'selected' : '' %>>Nome</option>
        <option value="usuario" <%=ordenar==='usuario' ? 'selected' : '' %>>Login</option>
        <option value="ativo" <%=ordenar==='ativo' ? 'selected' : '' %>>Status</option>
        <option value="is_admin" <%=ordenar==='is_admin' ? 'selected' : '' %>>Permissão</option>
        <option value="id" <%=ordenar==='id' ? 'selected' : '' %>>ID</option>
      </select>
    </div>

    <!-- Reinicia na página 1 -->
    <input type="hidden" name="pg" value="1" />

    <div>
      <label class="block text-sm font-medium text-transparent mb-1 select-none">.</label>
      <button type="submit"
        class="rounded-lg px-4 py-2 bg-sistema-600 text-white hover:bg-sistema-700 shadow">Buscar</button>
    </div>
  </form>

  <!-- Grid de Cards -->
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% for (let usuario of usuarios) { %>
      <div class="bg-white rounded-lg shadow-md p-4 flex flex-col justify-between border border-gray-200
           hover:shadow-xl hover:-translate-y-1 hover:bg-sistema-50 transition-all duration-300 ease-in-out"
        title="Clique nos botões para editar ou deletar este usuário">

        <div>
          <!-- Nome -->
          <p class="font-semibold text-sistema-700 text-base md:text-lg mb-1 break-words">
            <%= usuario.nome %>
          </p>

          <!-- Login -->
          <p class="text-gray-500 text-sm">Login:</p>
          <p class="text-gray-800 mb-2 break-all"><%= usuario.usuario %></p>

          <!-- Permissão -->
          <p class="text-gray-500 text-sm">Permissão:</p>
          <% if (usuario.is_admin) { %>
            <p class="text-sucesso-700 font-medium mb-2">Administrador</p>
          <% } else { %>
            <p class="text-gray-700 font-medium mb-2">Usuário comum</p>
          <% } %>

          <!-- Status -->
          <p class="text-gray-500 text-sm">Status:</p>
          <% if (usuario.is_ativo) { %>
            <p class="text-sucesso-700 font-medium">Ativo</p>
          <% } else { %>
            <p class="text-gray-500 font-medium">Inativo</p>
          <% } %>
        </div>

        <!-- Botões -->
        <div class="flex justify-end gap-3 mt-3">
          <form action="/usuarios/<%= usuario.id_usuario %>/editar" method="GET">
            <button type="submit" title="Editar usuário"
              class="bg-sucesso-600 hover:bg-sucesso-700 text-white p-2 rounded-full shadow flex items-center justify-center transition-transform hover:scale-110">
              <img src="/img/edit.svg" alt="Editar" class="w-4 h-4 md:w-5 md:h-5">
            </button>
          </form>

          <form action="/usuarios/<%= usuario.id_usuario %>/deletar" method="POST"
            onsubmit="return confirm('Deseja realmente excluir este usuário?')">
            <button type="submit" title="Excluir usuário"
              class="bg-erro-600 hover:bg-erro-700 text-white p-2 rounded-full shadow flex items-center justify-center transition-transform hover:scale-110">
              <img src="/img/delete.svg" alt="Deletar" class="w-4 h-4 md:w-5 md:h-5">
            </button>
          </form>
        </div>
      </div>
    <% } %>
  </div>

  <!-- Vazio -->
  <% if (!usuarios || !usuarios.length) { %>
    <div class="mt-6 p-6 border border-dashed border-gray-300 rounded-2xl text-center text-gray-600">
      Nenhum usuário encontrado.
    </div>
  <% } %>

  <!-- Paginação -->
  <% 
    const _busca=encodeURIComponent(busca || '');
    const _ordenar=encodeURIComponent(ordenar || 'nome');
    const mkUrl=(p)=> `/usuarios?busca=${_busca}&ordenar=${_ordenar}&pg=${p}`;
  %>

  <div class="flex justify-center items-center gap-3 my-6">
    <% if (pgAtual > 1) { %>
      <a href="<%= mkUrl(1) %>" class="px-3 py-1 rounded border border-gray-300 hover:bg-gray-50">&laquo; Primeiro</a>
      <a href="<%= mkUrl(pgAtual - 1) %>" class="px-3 py-1 rounded border border-gray-300 hover:bg-gray-50">Anterior</a>
    <% } %>

    <span class="text-sm text-gray-700">
      Página <span class="font-semibold"><%= pgAtual %></span>
      de <span class="font-semibold"><%= totalPgs %></span>
    </span>

    <% if (pgAtual < totalPgs) { %>
      <a href="<%= mkUrl(pgAtual + 1) %>" class="px-3 py-1 rounded border border-gray-300 hover:bg-gray-50">Próxima</a>
      <a href="<%= mkUrl(totalPgs) %>" class="px-3 py-1 rounded border border-gray-300 hover:bg-gray-50">Última &raquo;</a>
    <% } %>
  </div>

  <!-- FAB -->
  <a href="/usuarios/novo" aria-label="Adicionar Usuário" title="Adicionar novo usuário" class="fixed right-6 bottom-24 md:bottom-8 z-50
    w-14 h-14 rounded-full bg-gradient-to-b from-sistema-500 to-sistema-700 text-white
    flex items-center justify-center shadow-lg
    hover:shadow-xl hover:scale-110 transition-all duration-300
    focus:outline-none focus:ring-4 focus:ring-white/50">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor">
      <path d="M11 5a1 1 0 1 1 2 0v6h6a1 1 0 1 1 0 2h-6v6a1 1 0 1 1-2 0v-6H5a1 1 0 1 1 0-2h6V5z" />
    </svg>
  </a>
</main>

<%- include('../includes/footer.ejs') %>
