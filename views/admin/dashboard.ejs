<%- include('../includes/header.ejs', { titulo: 'Painel Administrativo' }) %>

<main class="p-6 min-h-screen bg-neutra-50">

  <% if (typeof mensagem !== 'undefined' && mensagem) { %>
    <div class="max-w-7xl mx-auto px-4">
      <p class="text-red-600 mb-4"><%= mensagem %></p>
    </div>
  <% } %>



  <!-- Cards de indicadores -->
  <section class="max-w-7xl mx-auto px-4 grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
    <div class="bg-white rounded-xl shadow border border-gray-200 p-4">
      <p class="text-gray-500 text-sm">Produtos ativos</p>
      <p class="text-2xl font-bold text-sistema-700">
        <%= indicadores.total_produtos_ativos || 0 %>
      </p>
    </div>

    <div class="bg-white rounded-xl shadow border border-gray-200 p-4">
      <p class="text-gray-500 text-sm">Itens em estoque</p>
      <p class="text-2xl font-bold text-sistema-700">
        <%= indicadores.total_itens_estoque || 0 %>
      </p>
    </div>

    <div class="bg-white rounded-xl shadow border border-gray-200 p-4">
      <p class="text-gray-500 text-sm">Abaixo do mínimo</p>
      <p class="text-2xl font-bold <%= (indicadores.itens_baixo_estoque||0) > 0 ? 'text-erro-600' : 'text-sistema-700' %>">
        <%= indicadores.itens_baixo_estoque || 0 %>
      </p>
    </div>

    <div class="bg-white rounded-xl shadow border border-gray-200 p-4">
      <p class="text-gray-500 text-sm">Valor total do estoque</p>
      <p class="text-2xl font-bold text-sistema-700">
        R$ <%= Number(indicadores.valor_total_estoque || 0).toFixed(2).replace('.', ',') %>
      </p>
    </div>
  </section>

  <!-- Gráfico + Lista -->
  <section class="max-w-7xl mx-auto px-4 grid gap-6 lg:grid-cols-3 mt-6">

    <!-- Gráfico -->
    <div class="lg:col-span-2 bg-white rounded-xl shadow border border-gray-200 p-4 overflow-x-auto">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-lg font-semibold text-sistema-700">Estoque por categoria</h3>
      </div>

      <div class="relative w-full h-64 md:h-80">
        <canvas id="chartCategorias" class="w-full h-full"></canvas>
      </div>
    </div>

    <!-- Lista de baixo estoque -->
    <div class="bg-white rounded-xl shadow border border-gray-200 p-4">
      <h3 class="text-lg font-semibold text-sistema-700 mb-3">Atenção: Baixo estoque</h3>

      <% if (!baixoEstoque || baixoEstoque.length === 0) { %>
        <p class="text-gray-500 text-sm">Tudo certo! Nenhum item no limite.</p>
      <% } else { %>
        <ul class="divide-y divide-gray-200">
          <% for (let p of baixoEstoque) { %>
            <li class="py-2 flex items-center justify-between gap-3">
              <div class="min-w-0">
                <p class="font-medium text-gray-800 truncate" title="<%= p.nome_produto %>">
                  <%= p.nome_produto %>
                </p>
                <p class="text-gray-500 text-sm break-words">
                  <%= p.nome_categoria %>
                </p>
              </div>
              <div class="text-right shrink-0">
                <p class="text-sm">
                  <span class="text-gray-500">Qtd:</span>
                  <span class="<%= p.quantidade <= p.estoque_minimo ? 'text-erro-600 font-semibold' : 'text-gray-800' %>">
                    <%= p.quantidade %>
                  </span>
                </p>
                <p class="text-xs text-gray-500">Mín: <%= p.estoque_minimo %></p>
              </div>
            </li>
          <% } %>
        </ul>
      <% } %>
    </div>
  </section>
</main>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  (function () {
    const _pc = <%- JSON.stringify(porCategoria || []) %>;

    const labels = _pc.map(x => x?.nome_categoria ?? '—');
    const data   = _pc.map(x => Number(x?.total_itens ?? 0));

    if (!labels.length) {
      console.warn("Sem dados para gráfico.");
      return;
    }

    const ctx = document.getElementById('chartCategorias')?.getContext('2d');
    if (!ctx) return;

    new Chart(ctx, {
      type: 'bar',
      data: {
        labels,
        datasets: [{
          label: 'Itens em estoque',
          data,
          backgroundColor: 'rgba(25, 184, 186, 0.7)',
          borderColor:     'rgba(25, 184, 186, 1)',
          borderWidth: 1,
          borderRadius: 4
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        layout: { padding: { right: 8 } },
        scales: {
          x: { ticks: { maxRotation: 45, minRotation: 0 } },
          y: { beginAtZero: true, ticks: { precision: 0 } }
        }
      }
    });
  })();
</script>

<%- include('../includes/footer.ejs') %>
